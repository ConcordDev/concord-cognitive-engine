      "rationale": "NEW gate: reject expired envelopes."
    },
    {
      "step": 8,
      "concern": "preconditions",
      "rationale": "NEW gate: confirm required state before executing."
    },
    {
      "step": 9,
      "concern": "idempotency",
      "rationale": "NEW gate: prevent non-idempotent replay."
    },
    {
      "step": 10,
      "concern": "execution_wrapping",
      "rationale": "Run capability through Execution Envelope."
    },
    {
      "step": 11,
      "concern": "verification",
      "rationale": "NEW gate: post-condition probe before declaring success."
