{
  "$note": "Textbook cases with known answers. A recipe run whose inputs equal a case must reproduce the expected values (relative tolerance below). Oracles are closed-form hand calculations, not solver output.",
  "version": 1,
  "tolerance": 0.002,
  "cases": [
    { "id": "beam-footbridge-a36", "recipe": "beam_sizing", "source": "Gere & Goodno, Mechanics of Materials: M = PL/4, sigma = Mc/I, delta = PL^3/48EI; R10 depth (ISO 3)",
      "inputs": { "spanM": 4, "loadN": 10000, "widthM": 0.06, "material": "steel-a36", "safetyFactor": 2, "deflectionLimit": 360 },
      "expect": { "maxMomentNm": 10000, "depthM": 0.125, "governs": "deflection", "sizing.strengthDepthM": 0.1 } },
    { "id": "beam-footbridge-6061", "recipe": "beam_sizing", "source": "same hand calculation, E = 68.9 GPa, Fy = 276 MPa (library)",
      "inputs": { "spanM": 4, "loadN": 10000, "widthM": 0.06, "material": "aluminum-6061-t6", "safetyFactor": 2, "deflectionLimit": 360 },
      "expect": { "depthM": 0.16, "governs": "deflection", "sizing.strengthDepthM": 0.1 } },
    { "id": "column-euler-60x100-a36", "recipe": "column_buckling", "source": "Euler: Pcr = pi^2 E I/(KL)^2, weak axis I = 0.1*0.06^3/12 = 1.8e-6 m^4",
      "inputs": { "lengthM": 2.5, "modulusPa": 200000000000, "widthM": 0.06, "heightM": 0.1, "loadN": 80000 },
      "expect": { "criticalLoadN": 568500, "factorOfSafety": 7.1063, "slenderness": 144.34, "momentOfInertiaM4": 1.8e-6 }, "tolerance": 0.001 },
    { "id": "vessel-cylinder-hoop", "recipe": "pressure_vessel", "source": "Hibbeler: hoop = pr/t, axial = pr/2t (thin wall)",
      "inputs": { "pressurePa": 1500000, "radiusM": 0.5, "thicknessM": 0.01, "shape": "cylinder" },
      "expect": { "hoopStressPa": 75000000, "axialStressPa": 37500000 } },
    { "id": "vessel-sphere", "recipe": "pressure_vessel", "source": "Hibbeler: sphere sigma = pr/2t",
      "inputs": { "pressurePa": 1500000, "radiusM": 0.5, "thicknessM": 0.01, "shape": "sphere" },
      "expect": { "hoopStressPa": 37500000 } },
    { "id": "wall-conduction", "recipe": "wall_conduction", "source": "Fourier: Q = kA dT/L (Incropera)",
      "inputs": { "conductivityWmK": 0.8, "areaM2": 10, "thicknessM": 0.2, "deltaTK": 20 },
      "expect": { "heatFlowW": 800, "thermalResistanceKPerW": 0.025 } },
    { "id": "pipe-laminar-hagen-poiseuille", "recipe": "pipe_flow", "source": "Hagen-Poiseuille: dp = 32 mu L v / D^2",
      "inputs": { "densityKgM3": 998, "viscosityPaS": 0.001, "velocityMs": 0.01, "diameterM": 0.05, "lengthM": 10 },
      "expect": { "regime": "laminar", "reynolds": 499, "pressureDropPa": 1.28 } },
    { "id": "stoichiometry-water", "recipe": "reaction_balance", "source": "2 H2 + O2 -> 2 H2O",
      "inputs": { "equation": "H2 + O2 -> H2O" },
      "expect": { "coefficients.H2": 2, "coefficients.O2": 1, "coefficients.H2O": 2, "molarMassGPerMol.H2O": 18.015 } },
    { "id": "stoichiometry-rust", "recipe": "reaction_balance", "source": "4 Fe + 3 O2 -> 2 Fe2O3",
      "inputs": { "equation": "Fe + O2 -> Fe2O3" },
      "expect": { "coefficients.Fe": 4, "coefficients.O2": 3, "coefficients.Fe2O3": 2 } }
  ]
}
