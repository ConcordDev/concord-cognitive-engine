{
  "name": "concord-server",
  "private": true,
  "version": "5.0.0",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "scripts": {
    "start": "MAX_OLD_SPACE_SIZE=32768 node --max-old-space-size=32768 --expose-gc server.js",
    "dev": "MAX_OLD_SPACE_SIZE=32768 node --max-old-space-size=32768 --expose-gc --watch server.js",
    "test": "npm run test:main && npm run test:behavior",
    "test:main": "NODE_ENV=test node --test --import=./tests/preload/no-egress.mjs --test-timeout=300000 'tests/**/*.test.js' 'tests/**/*-tests.js'",
    "test:clean-exit": "NODE_ENV=test node --test --import=./tests/preload/no-egress.mjs --test-timeout=300000 'tests/**/*.test.js' 'tests/**/*-tests.js'",
    "test:ci": "node scripts/ci-test-tolerant.mjs",
    "test:depth:ci": "node scripts/ci-test-tolerant.mjs --depth-only",
    "test:depth:raw": "NODE_ENV=test DB_PATH=/tmp/deploy-gate-depth.db node --test --import=./tests/preload/no-egress.mjs --test-concurrency=1 --test-timeout=60000 'tests/depth/*.test.js'",
    "test:watch": "node --test --watch --test-timeout=60000 'tests/**/*.test.js' 'tests/**/*-tests.js'",
    "test:coverage": "NODE_ENV=test node --test --import=./tests/preload/no-egress.mjs --test-timeout=60000 --experimental-test-coverage 'tests/**/*.test.js' 'tests/**/*-tests.js'",
    "test:e2e": "node --test --test-timeout=300000 'tests/e2e/**/*.test.js'",
    "test:behavior": "NODE_ENV=test node --test --import=./tests/preload/no-egress.mjs --test-timeout=900000 tests/behavior/lens-behavior-smoke.behavior.js",
    "test:sim": "node --test --test-timeout=120000 'tests/sim/**/*.test.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check-deps": "node scripts/check-emergent-deps.js",
    "check-route-auth": "node scripts/check-route-auth.js",
    "check-route-auth:update": "node scripts/check-route-auth.js --update",
    "migrate": "node migrate.js",
    "migrate:status": "node migrate.js --status",
    "fetch-pyodide-packages": "node scripts/fetch-pyodide-packages.mjs",
    "fetch-pyodide-packages:check": "node scripts/fetch-pyodide-packages.mjs --check",
    "smoke": "bash scripts/smoke.sh",
    "preflight": "bash ../scripts/preflight-production.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "cartograph": "node scripts/cartograph.js",
    "cartograph:static": "node scripts/cartograph.js --static",
    "cartograph:diff": "node scripts/cartograph.js --static --diff",
    "cartograph:graph": "node scripts/cartograph.js --static && (which dot >/dev/null 2>&1 && dot -Tsvg ../audit/cartograph/systems-graph.dot -o ../audit/cartograph/systems-graph.svg && echo 'systems-graph.svg rendered' || echo 'graphviz dot not on PATH; .dot source committed')",
    "detectors": "node scripts/run-detectors.js",
    "detectors:report": "node scripts/run-detectors.js --out ../audit/detectors/REPORT.md",
    "detectors:json": "node scripts/run-detectors.js --json",
    "detectors:diff": "node scripts/run-detectors.js --diff",
    "detectors:ci": "node scripts/run-detectors.js --ci",
    "detectors:baseline": "node scripts/run-detectors.js --rewrite-baseline",
    "detectors:history": "node scripts/run-detectors.js --append-history",
    "detectors:autofix": "node scripts/repair-cortex-apply.js --apply-all-low-risk",
    "repair-cortex:scan": "node scripts/repair-cortex-scan.js",
    "repair-cortex:apply": "node scripts/repair-cortex-apply.js",
    "cartograph:reason": "node scripts/cartograph-reason.js",
    "cartograph:reason:stress": "node scripts/cartograph-reason.js --stress-only",
    "cartograph:reason:diff": "node scripts/cartograph-reason.js --diff",
    "bench:dhtp-rs": "node scripts/run-dhtp-rs.mjs",
    "bench:dhtp-rs:status": "node scripts/run-dhtp-rs.mjs status",
    "bench:dhtp-rs:resume": "node scripts/run-dhtp-rs.mjs resume",
    "bench:dhtp-rs:run-all": "node scripts/run-dhtp-rs.mjs run-all --provider ollama",
    "bench:dhtp-rs:phase2": "node scripts/run-dhtp-rs.mjs phase2",
    "bench:dhtp-rs:test": "node scripts/run-dhtp-rs.mjs test",
    "substrate:invoke-oracles": "node ../scripts/substrate-invoke-oracles.mjs",
    "substrate:invoke-covered": "node ../scripts/substrate-invoke-oracles.mjs --covered --json-out audit/substrate-invocation.json",
    "capability:manifest": "node ../scripts/macro-capability-manifest.mjs",
    "capability:manifest:live": "node ../scripts/macro-capability-manifest.mjs --live",
    "lens:behavioral": "node ../scripts/lens-behavioral-harness.mjs",
    "lens:behavioral:sentinel": "node ../scripts/lens-behavioral-harness.mjs --lens sentinel",
    "lens:behavioral:fast": "node ../scripts/lens-behavioral-harness.mjs --no-check-logging",
    "capability:coverage": "node ../scripts/runtime-capability-coverage.mjs",
    "capability:coverage:fast": "node ../scripts/runtime-capability-coverage.mjs --class A --no-check-logging",
    "capability:coverage:sample": "node ../scripts/runtime-capability-coverage.mjs --limit 50 --no-check-logging",
    "capability:coverage:interactive": "node ../scripts/runtime-interactive-coverage.mjs",
    "capability:coverage:crosslayer": "node ../scripts/runtime-crosslayer-coverage.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@redis/client": "^1.6.0",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "acorn": "^8.16.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "http-signature": "^1.4.0",
    "jsmidgen": "^0.1.8",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "playwright": "^1.62.0",
    "prom-client": "^15.1.0",
    "pyodide": "^314.0.3",
    "socket.io": "^4.7.4",
    "sqlite-vec": "^0.1.9",
    "stripe": "^22.4.0",
    "typescript": "^5.9.3",
    "undici": "7.29.0",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.2",
    "y-websocket": "^3.0.0",
    "yaml": "^2.9.0",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "meilisearch": "^0.60.0",
    "pg": "^8.16.3",
    "redis": "^4.7.1"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
