# Dependencies
node_modules
npm-debug.log
yarn-error.log

# Git
.git
.gitignore

# Environment files (secrets)
.env
.env.local
.env.*.local

# Next.js build output (will be rebuilt in container)
.next
out

# Development files
.vscode
.idea
*.swp
*.swo
.DS_Store

# Test files. .dockerignore patterns are anchored at the context root, with
# no implicit "**/", so the nested forms are needed too. Otherwise
# components/**/*.test.tsx files ship into the image, and next build's
# type-check fails on their imports of the excluded tests/ helpers.
test
tests
__tests__
**/__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage
cypress
e2e

# Documentation
*.md
!README.md

# Storybook
.storybook
storybook-static

# Logs
logs
*.log

# Temporary files
tmp
temp
.tmp

# TypeScript build info
*.tsbuildinfo

# Playwright
playwright-report
test-results
