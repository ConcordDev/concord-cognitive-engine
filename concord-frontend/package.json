{
  "name": "concord-frontend",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ../server/scripts/prophet-check.js && next build",
    "build:ci": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "start:ci": "NODE_OPTIONS='--max-old-space-size=4096' next start -p 3000",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --exclude='**/tests/smoke/**'",
    "test:smoke": "vitest run tests/smoke/",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test --config=playwright.config.ts",
    "test:e2e:infra": "playwright test --config=playwright-infra.config.ts",
    "test:e2e:walk": "playwright test --config=playwright-walk.config.ts",
    "test:a11y": "npx playwright test tests/e2e/accessibility.spec.ts",
    "type-check": "tsc --noEmit",
    "validate-routes": "npx tsx scripts/validate-routes.ts",
    "score-lenses": "npx tsx scripts/score-lenses.ts",
    "validate-lens-quality": "npx tsx scripts/validate-lens-quality.ts",
    "validate-production-grade": "npx tsx scripts/validate-production-grade-lens.ts",
    "validate-production-grade:strict": "npx tsx scripts/validate-production-grade-lens.ts --strict",
    "validate-lens-quality:strict": "npx tsx scripts/validate-lens-quality.ts --strict",
    "prepare": "husky"
  },
  "dependencies": {
    "@conform-to/zod": "^1.20.0",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@excalidraw/excalidraw": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-context-menu": "^2.3.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.66.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-mention": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/extension-table-cell": "^3.28.0",
    "@tiptap/extension-table-header": "^3.28.0",
    "@tiptap/extension-table-row": "^3.28.0",
    "@tiptap/extension-task-item": "^3.28.0",
    "@tiptap/extension-task-list": "^3.28.0",
    "@tiptap/extension-typography": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/suggestion": "^3.28.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.18.1",
    "clsx": "^2.1.0",
    "cytoscape": "^3.34.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "fflate": "0.8.3",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "katex": "0.18.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^5.24.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^6.0.0",
    "next": "^16.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "recharts": "^3.9.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.41.0",
    "@size-limit/preset-app": "^12.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.2.4",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "dompurify": "^3.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
