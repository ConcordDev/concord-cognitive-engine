{
  "name": "concord-frontend",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ../server/scripts/prophet-check.js && next build",
    "build:ci": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "start:ci": "NODE_OPTIONS='--max-old-space-size=4096' next start -p 3000",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --exclude='**/tests/smoke/**'",
    "test:smoke": "vitest run tests/smoke/",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test --config=playwright.config.ts",
    "test:e2e:infra": "playwright test --config=playwright-infra.config.ts",
    "test:e2e:walk": "playwright test --config=playwright-walk.config.ts",
    "test:a11y": "npx playwright test tests/e2e/accessibility.spec.ts",
    "type-check": "tsc --noEmit",
    "type-check:ci": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "validate-routes": "npx tsx scripts/validate-routes.ts",
    "score-lenses": "npx tsx scripts/score-lenses.ts",
    "validate-lens-quality": "npx tsx scripts/validate-lens-quality.ts",
    "validate-production-grade": "npx tsx scripts/validate-production-grade-lens.ts",
    "validate-production-grade:strict": "npx tsx scripts/validate-production-grade-lens.ts --strict",
    "validate-lens-quality:strict": "npx tsx scripts/validate-lens-quality.ts --strict",
    "prepare": "husky"
  },
  "dependencies": {
    "@conform-to/zod": "^1.0.0",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@excalidraw/excalidraw": "^0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.50.0",
    "@tanstack/react-query": "^5.17.0",
    "@tiptap/extension-highlight": "^2.2.0",
    "@tiptap/extension-image": "^2.2.0",
    "@tiptap/extension-link": "^2.2.0",
    "@tiptap/extension-mention": "^2.2.0",
    "@tiptap/extension-placeholder": "^2.2.0",
    "@tiptap/extension-table": "^2.2.0",
    "@tiptap/extension-table-cell": "^2.2.0",
    "@tiptap/extension-table-header": "^2.2.0",
    "@tiptap/extension-table-row": "^2.2.0",
    "@tiptap/extension-task-item": "^2.2.0",
    "@tiptap/extension-task-list": "^2.2.0",
    "@tiptap/extension-typography": "^2.2.0",
    "@tiptap/react": "^2.2.0",
    "@tiptap/starter-kit": "^2.2.0",
    "@tiptap/suggestion": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.16.1",
    "clsx": "^2.1.0",
    "cytoscape": "^3.28.1",
    "date-fns": "^3.2.0",
    "dexie": "^3.2.4",
    "fflate": "0.6.10",
    "framer-motion": "^11.0.3",
    "fuse.js": "^7.0.0",
    "gsap": "^3.15.0",
    "katex": "0.16.45",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.309.0",
    "maplibre-gl": "^4.7.1",
    "monaco-editor": "^0.56.0",
    "nanoid": "^5.0.4",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.2.6",
    "react-hotkeys-hook": "^4.4.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.6.2",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^2.2.0",
    "three": "^0.160.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@size-limit/preset-app": "^13.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.18",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.1",
    "sharp": "^0.35.0",
    "postcss": "^8.5.18",
    "lodash-es": "^4.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
