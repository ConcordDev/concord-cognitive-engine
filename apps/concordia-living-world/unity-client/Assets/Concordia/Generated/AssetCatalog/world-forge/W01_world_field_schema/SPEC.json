{
  "schema": "concordia-world-forge-field/1.0",
  "slice_id": "W01_world_field_schema",
  "phase": "G0",
  "batch": "WF0_field_schema",
  "title": "World Field schema: elevation, slope, climate, drainage, soil, geology, water, biome, resource, fertility",
  "consumes": {
    "schema": "concordia-world-forge-canon-graph/1.0",
    "slice_id": "W00_world_forge_canon_graph",
    "path": "world-forge/W00_world_forge_canon_graph/SPEC.json"
  },
  "authority_docs": [
    "lookfeel/MAP_MASTER.json",
    "lookfeel/geography/GEO_Hub.md",
    "lookfeel/geography/GEO_Fantasy.md",
    "lookfeel/geography/GEO_Tunya.md",
    "WORLD_FORGE_GEO_CIV_AUDIT.md"
  ],
  "honesty": "Region ids, frames, and affinities are copied from the W00 canon graph. Exemplar numeric bands are design_intent class ranges, not station data and not a generated raster. Resource quantity is null. Unplaced Tunya names have channels null. The play patch constants are copied from server/lib/world-terrain.js and are not retuned here.",
  "pipeline": [
    "elevation",
    "hydrology",
    "climate",
    "biome",
    "resources",
    "mobility",
    "suitability",
    "civ",
    "pop",
    "economy",
    "growth",
    "infra",
    "physicalization"
  ],
  "pipeline_note": "Hydrology places channels from elevation plus W00 water_dependency. Climate writes temperature, rainfall, and humidity afterwards as volume and season. Rainfall must not redraw a channel.",
  "continent": {
    "id": "concordia_megaworld",
    "frame": "megaworld_km",
    "origin": "Hub",
    "axes": "+x east toward Cyber, +z north toward the Sundering",
    "ring_km": 400.0,
    "seas": ["inner_veil", "exodus_ocean"],
    "discs_are": "worlds on one field, not separate continents",
    "worlds_exemplified_this_slice": ["Hub", "Fantasy", "Tunya"],
    "worlds_pending_same_schema": ["Cyber", "Ruins", "Frontier", "Crime", "Superhero", "Crucible", "Sere"]
  },
  "frames": {
    "continental_veil_datum": {
      "unit": "metres above the Inner Veil / Exodus water plane",
      "horizontal": "megaworld_km",
      "later_cell_km": 2.0,
      "later_cell_authority": "design_intent",
      "note": "G1 writes this grid. Exemplars are one class band per region, not cells."
    },
    "hub_court_walk": {
      "unit": "metres above the Hub walk surface",
      "horizontal": "hub_canon_metres",
      "flower_law_radius_m": 42,
      "flower_law_axis": "horizontal radius, not elevation",
      "ring_of_doors_m": 34,
      "wall_m": 56,
      "arena_exception": "Arena sand is a steel exception inside the 42 m disk, not a continental crater."
    },
    "play_patch_metres": {
      "source": "server/lib/world-terrain.js",
      "symbols": ["renderedElevationAt", "generatePoughkeepsieHeightmap", "terrainSpec", "sampleRenderedHeight"],
      "terrain_size_m": 2000,
      "max_elevation_m": 80,
      "seed": 12648430,
      "seed_hex": "0xc0ffee",
      "seed_is_per_world": false,
      "sampled_grid": 64,
      "sampled_cell_m": 31.25,
      "sample_convention": "nx = col/width, nz = row/height, not divided by dim-1",
      "output": "terrainSpec sampledGrid is elevation/80 in [0,1]",
      "deformation_cell_m": 10,
      "deformation_cell_symbol": "CELL_SIZE",
      "deformation_cell_env": "CONCORD_TERRAIN_CELL_M",
      "hash_seed": {
        "symbol": "hashSeed",
        "algorithm": "fnv1a-32",
        "applies_to_rendered_grid": false,
        "future_use": "Micro-relief amplitude inside the 0–80 m clamp only. Not a continental height."
      },
      "must_not": "Add continental_veil_datum metres to renderedElevationAt. Resample exemplars into sampledGrid. Store 42 as an elevation."
    },
    "local_claim_metres": {
      "note": "countries.json circles and Fluxom Gate (62, 18) m stay here. They are not field cells."
    }
  },
  "slope_classes": [
    { "id": "near_level", "rise_over_run_max_exclusive": 0.04 },
    { "id": "gentle", "rise_over_run_max_exclusive": 0.12 },
    { "id": "moderate", "rise_over_run_max_exclusive": 0.25 },
    { "id": "steep", "rise_over_run_max_exclusive": 0.5 },
    { "id": "cliff", "rise_over_run_min_inclusive": 0.5 }
  ],
  "channel_contract": [
    {
      "id": "elevation",
      "unit": "m",
      "written_by": "elevation",
      "read_by": ["hydrology", "slope"],
      "rule": "class is one of the region terrain_affinity tags from W00"
    },
    {
      "id": "slope",
      "unit": "rise_over_run",
      "written_by": "elevation",
      "derived_from": "elevation",
      "read_by": ["mobility", "suitability"],
      "rule": "derived from neighbour elevation; never an independent authoring"
    },
    {
      "id": "geology",
      "unit": "class",
      "written_by": "elevation",
      "read_by": ["biome", "resources"],
      "rule": "rock rides with the landform; not a fourteenth pipeline stage"
    },
    {
      "id": "drainage",
      "unit": "watershed_id",
      "written_by": "hydrology",
      "read_by": ["climate", "biome", "fertility"],
      "rule": "obeys W00 water_dependency.forbidden"
    },
    {
      "id": "water",
      "unit": "kind",
      "written_by": "hydrology",
      "read_by": ["biome", "economy", "terrain-water.setWater"],
      "rule": "kind none is filled. A forbidden kind is an error. Play-patch seeding uses terrain-water.js only."
    },
    {
      "id": "temperature",
      "unit": "celsius_mean_annual_band",
      "written_by": "climate",
      "read_by": ["biome"],
      "rule": "design_intent band. A local anomaly is not the regional mean."
    },
    {
      "id": "rainfall",
      "unit": "mm_per_year_band",
      "written_by": "climate",
      "read_by": ["biome", "fertility"],
      "rule": "does not redraw drainage"
    },
    {
      "id": "humidity",
      "unit": "fraction_0_1_band",
      "written_by": "climate",
      "read_by": ["biome"],
      "rule": "local mist stays on the water body, not the whole disc"
    },
    {
      "id": "biome",
      "unit": "class",
      "written_by": "biome",
      "read_by": ["resources", "physicalization"],
      "rule": "agrees with W00 climate_tag and flora_budget"
    },
    {
      "id": "soil",
      "unit": "class",
      "written_by": "biome",
      "read_by": ["fertility"],
      "rule": "derived from geology, drainage, and climate. Paving is a class."
    },
    {
      "id": "resource",
      "unit": "id",
      "written_by": "resources",
      "read_by": ["economy"],
      "rule": "subset of the W00 region resource ids; quantity null"
    },
    {
      "id": "fertility",
      "unit": "score_0_1",
      "written_by": "resources",
      "derived_from": ["soil", "rainfall", "drainage"],
      "read_by": ["suitability"],
      "rule": "civ, pop, and economy do not write it. suitability_cap can veto a high score."
    }
  ],
  "integration": [
    {
      "id": "world_terrain",
      "path": "server/lib/world-terrain.js",
      "symbols": ["terrainSpec", "generatePoughkeepsieHeightmap", "renderedElevationAt", "sampleRenderedHeight", "hashSeed"],
      "today": "Play patch only. Fixed seed 0xc0ffee. hashSeed(worldId) is not consumed by the rendered grid. The same patch is served for every worldId.",
      "field_extends": "Continental class bands live beside the patch. A later reader refuses a play-patch sample whose class is outside the region affinity. hashSeed may drive micro-relief inside the existing 0–80 m clamp.",
      "known_gap": "Until that reader and G1 exist, the Poughkeepsie patch is the only numeric elevation Concord serves, including on Fantasy and Tunya.",
      "do_not": "Replace the formula, add veil-datum metres into renderedElevationAt, or encode Flower Law 42 as elevation."
    },
    {
      "id": "terrain_deformation",
      "path": "server/lib/terrain-deformation.js",
      "symbols": ["baseElevation", "CELL_SIZE"],
      "today": "baseElevation delegates to renderedElevationAt. Cell is 10 m unless CONCORD_TERRAIN_CELL_M is set.",
      "field_extends": "No new deformation. Digs stay on the play patch.",
      "do_not": "Store the continental grid in the deformation table."
    },
    {
      "id": "terrain_water",
      "path": "server/lib/terrain-water.js",
      "symbols": ["solveFlowStep", "setWater", "tickWaterFlow", "waterDepthAt"],
      "today": "4-neighbour flow on the play-patch cell. Volume conserved.",
      "field_extends": "G2 may seed setWater only where exemplar water.kind is a surface body and the cell sits in the play patch. Field depth_m is a design-intent band, not a column to copy.",
      "do_not": "A second solver, a Hub plaza seed, or a Sundering lake seed."
    },
    {
      "id": "procgen_settlements",
      "path": "server/lib/procgen-settlements.js",
      "symbols": ["spawnSettlementForRegion"],
      "cycle": "server/emergent/procgen-settlement-cycle.js",
      "today": "3–5 NPCs and a Living Society settlements row.",
      "field_extends": "Suitability may later choose an existing region_id using slope, water.kind, and fertility.",
      "do_not": "Treat fertility as a city physicalizer or replace spawnSettlementForRegion."
    },
    {
      "id": "faction_strategy",
      "path": "server/lib/embodied/faction-strategy.js",
      "domain": "server/domains/faction-strategy.js",
      "cycle": "server/emergent/faction-strategy-cycle.js",
      "today": "Stance machine on authored factions.",
      "field_extends": "A move may name a region_id or a water.body_id already in this field.",
      "do_not": "Mint a kingdom from a fertile cell. Hub territories stay empty."
    },
    {
      "id": "unity_world_geography",
      "path": "Assets/Concordia/Scripts/GeographyRuntime.cs",
      "symbols": ["WorldGeography"],
      "today": "Routes and borders. Hub territories empty.",
      "field_extends": "Later bind so disc fields agree with the atlas.",
      "do_not": "Promote claim circles or the 0.55 m/km present scale into field metres."
    }
  ],
