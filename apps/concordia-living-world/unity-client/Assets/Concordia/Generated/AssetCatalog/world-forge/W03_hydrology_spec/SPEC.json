{
  "schema": "concordia-world-forge-hydrology/1.0",
  "slice_id": "W03_hydrology_spec",
  "phase": "G2",
  "batch": "WF2_hydrology",
  "title": "World-scale hydrology: flow direction, accumulation, watersheds, rivers, lakes, deltas, bridging to terrain-water.js",
  "consumes": [
    {
      "schema": "concordia-world-forge-continental/1.0",
      "slice_id": "W02_continental_spec",
      "path": "world-forge/W02_continental_spec/SPEC.json",
      "reads": ["elevation", "slope", "sea_mask", "coasts", "passes", "chains"]
    },
    {
      "schema": "concordia-world-forge-field/1.0",
      "slice_id": "W01_world_field_schema",
      "path": "world-forge/W01_world_field_schema/SPEC.json",
      "reads": ["drainage", "water", "exemplars Hub Fantasy Tunya"]
    },
    {
      "schema": "concordia-world-forge-canon-graph/1.0",
      "slice_id": "W00_world_forge_canon_graph",
      "path": "world-forge/W00_world_forge_canon_graph/SPEC.json",
      "reads": ["water_dependency", "seas", "walk_model_kmh.river_barge"]
    }
  ],
  "authority_docs": [
    "lookfeel/MAP_MASTER.json",
    "lookfeel/geography/",
    "WORLD_FORGE_GEO_CIV_AUDIT.md",
    "world-forge/GEO_CIV_AUDIT.md"
  ],
  "honesty": "Channels are a closed canon list. D8 accumulation chooses a path inside that list and does not add rivers. Depth bands are design-intent copies of W01, not soundings. The 2 km grid is a contract, not a file. Sere, tunya_unplaced, and tunya_fallback have no cells. Rainfall is unread because climate follows hydrology. The Poughkeepsie depression in renderedElevationAt is play_patch_legacy and is not a canon body. Play-patch seeding returns play_window_unplaced until a later slice sites the 2000 m window. No source term is added to solveFlowStep.",
  "pipeline": [
    "elevation",
    "hydrology",
    "climate",
    "biome",
    "resources",
    "mobility",
    "suitability",
    "civ",
    "pop",
    "economy",
    "growth",
    "infra",
    "physicalization"
  ],
  "writes_channels": ["drainage", "water"],
  "leaves_for_later_stages": [
    "temperature",
    "rainfall",
    "humidity",
    "biome",
    "soil",
    "resource",
    "fertility"
  ],
  "continent": {
    "id": "concordia_megaworld",
    "frame": "megaworld_km",
    "sea_level_m": 0,
    "sea_mask": "elevation_m <= 0",
    "seas": ["inner_veil", "exodus_ocean"],
    "world_id_fantasy_display": "The Sundering",
    "world_id_unchanged": "Fantasy",
    "flower_law": { "radius_m": 42, "axis": "horizontal", "world_id": "Hub", "not_a_watershed": true }
  },
  "grid": {
    "frame": "continental_veil_datum",
    "cell_km": 2.0,
    "origin_sw_km": { "x": -520, "z": -580 },
    "bbox_km": { "min_x": -520, "max_x": 520, "min_z": -580, "max_z": 520 },
    "cell_count_if_allocated": 286000,
    "materialized": false,
    "index": "gx = floor((x_km + 520) / 2); gz = floor((z_km + 580) / 2)"
  },
  "algorithm": {
    "name": "named_channel_d8",
    "order": [
      "inherit_g1",
      "d8_direction",
      "sinks",
      "accumulation_cells",
      "watershed_label",
      "realize_closed_list",
      "lakes_empty",
      "deltas_and_wetlands",
      "masks"
    ],
    "neighbourhood": "D8",
    "orthogonal_step_m": 2000,
    "diagonal_step_m": 2828.427,
    "flat_epsilon_m": 0.05,
    "tie_break": "lowest hashSeed(worldId:gx:gz:dir) via world-terrain.js hashSeed",
    "direction_codes": {
      "0": "E +gx",
      "1": "SE +gx -gz",
      "2": "S -gz",
      "3": "SW -gx -gz",
      "4": "W -gx",
      "5": "NW -gx +gz",
      "6": "N +gz",
      "7": "NE +gx +gz",
      "sink_sea": "orthogonal coast into elevation <= 0",
      "sink_internal": "authored sink only",
      "flat": "descent below 0.05 m",
      "pit_unrealized": "no sea pour and no authored sink; do not breach or fill",
      "unstamped": "Sere, tunya_unplaced, stamps_skipped"
    },
    "accumulation_unit": "cells",
    "rainfall_weight": null,
    "max_downstream_steps": 400,
    "pit_policy": "do not rewrite elevation",
    "realization_rule": "A cell is wet only when a closed-list row claims it. High accumulation without a claim stays kind none.",
    "coast_contact": "orthogonal only, matching W02 coast cells"
  },
  "local_solver": {
    "module": "server/lib/terrain-water.js",
    "symbols": ["solveFlowStep", "setWater", "tickWaterFlow", "waterDepthAt", "waterGridForWorld", "loadWaterGrid", "totalWater"],
    "neighbourhood": "4",
    "cell_m": 10,
    "cell_env": "CONCORD_TERRAIN_CELL_M",
    "flow_rate": 0.5,
    "flow_rate_env": "CONCORD_WATER_FLOW_RATE",
    "min_water_m": 0.01,
    "conserves_volume": true,
    "heartbeat": "server/emergent/water-flow-cycle.js#runWaterFlowCycle",
    "macros": {
      "set_water": "server/domains/terrain.js terrain.set_water → setWater",
      "water_depth": "terrain.water_depth → waterDepthAt",
      "flow_tick": "terrain.flow_tick → tickWaterFlow"
    },
    "upgrade_to_d8": false,
    "source_term_in_tick": false
  },
  "play_patch": {
    "source": "server/lib/world-terrain.js",
    "symbols": ["terrainSpec", "renderedElevationAt", "generatePoughkeepsieHeightmap", "hashSeed"],
    "authority": "play_patch_legacy",
    "seed": 12648430,
    "seed_hex": "0xc0ffee",
    "max_elevation_m": 80,
    "window_m": 2000,
    "canon_body_id": null,
    "note": "West-to-east depression is Poughkeepsie play geometry. It is not crime_working_river, sunder_short_run, or hub_civic_drain."
  },
  "bridge": {
    "function": "channelSeedForPlayPatch",
    "home": "server/lib/terrain-water.js",
    "shipped": false,
    "until_window_placed": { "ok": false, "reason": "play_window_unplaced" },
    "when_placed": {
      "depth_policy": "finite column at the band minimum, once",
      "resample_m": 10,
      "then": "solveFlowStep moves that volume; the heartbeat does not refill it",
      "sea_into_world_water_cells": false
    },
