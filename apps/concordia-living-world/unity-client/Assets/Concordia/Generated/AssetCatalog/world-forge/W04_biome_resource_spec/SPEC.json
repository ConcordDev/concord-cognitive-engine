  "spawn_allow_classes": ["temperate_oak_wood", "rune_scar_pine", "cliff_terrace", "hot_dune", "wet_canopy"],
  "aquatic_bodies": ["sunder_short_run", "tunya_masond_river", "tunya_fluxom_lock", "crime_working_river"],
  "aquatic_rule": "species key water is legal only for those bodies, and only after a play window is sited. Sea, steam, ice, civic drains, the Crucible sheet, and ephemeral kind none are excluded. creature-homes still skips biome water at insert.",
