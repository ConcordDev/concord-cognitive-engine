{
  "schema": "concordia-world-forge-biome-resource/1.0",
  "slice_id": "W04_biome_resource_spec",
  "phase": "G3",
  "batch": "WF3_biomes",
  "title": "Climate to biome to ecosystem and vegetation density, plus resource and fertility fields bound to GEO_* and STYLE_*",
  "consumes": [
    {
      "schema": "concordia-world-forge-hydrology/1.0",
      "slice_id": "W03_hydrology_spec",
      "path": "world-forge/W03_hydrology_spec/SPEC.json",
      "reads": ["drainage", "water", "channel body_id", "ephemeral", "realizes"]
    },
    {
      "schema": "concordia-world-forge-continental/1.0",
      "slice_id": "W02_continental_spec",
      "path": "world-forge/W02_continental_spec/SPEC.json",
      "reads": ["elevation", "slope", "geology", "sea_mask", "coasts"]
    },
    {
      "schema": "concordia-world-forge-field/1.0",
      "slice_id": "W01_world_field_schema",
      "path": "world-forge/W01_world_field_schema/SPEC.json",
      "reads": ["temperature", "rainfall", "humidity", "biome", "soil", "resource", "fertility", "exemplars Hub Fantasy Tunya"]
    },
    {
      "schema": "concordia-world-forge-canon-graph/1.0",
      "slice_id": "W00_world_forge_canon_graph",
      "path": "world-forge/W00_world_forge_canon_graph/SPEC.json",
      "reads": ["climate_tag", "flora_budget", "regions[].resources", "palette_ref"]
    }
  ],
  "authority_docs": [
    "lookfeel/MAP_MASTER.json",
    "lookfeel/geography/GEOGRAPHY_INDEX.json",
    "lookfeel/styles/STYLE_INDEX.json",
    "WORLD_FORGE_GEO_CIV_AUDIT.md",
    "world-forge/GEO_CIV_AUDIT.md"
  ],
  "honesty": "Region bands with band_authority w01_exemplar are copies of the W01 exemplar channels, not a recomputed lapse. design_intent rows are new in this slice and are not measurements. The 2 km grid is a contract, not a file. Geology is read and not rewritten. Resource quantity stays null. classifyBiome cones are a report and do not rename biome.class. STYLE hex and WorldVisualProfileCatalog vegetationDensity are presentation, not the field. Sere, tunya_unplaced, tunya_fallback, and frontier_last_dome_unplaced have no cells. No species id is added. Flower Law is a 42 m horizontal disk and is not a climate cell.",
  "pipeline": [
    "elevation",
    "hydrology",
    "climate",
    "biome",
    "resources",
    "mobility",
    "suitability",
    "civ",
    "pop",
    "economy",
    "growth",
    "infra",
    "physicalization"
  ],
  "writes_channels": [
    "temperature",
    "rainfall",
    "humidity",
    "biome",
    "soil",
    "resource",
    "fertility"
  ],
  "does_not_write": ["elevation", "slope", "geology", "drainage", "water"],
  "grid": {
    "frame": "continental_veil_datum",
    "cell_km": 2,
    "origin_sw_km": { "x_km": -520, "z_km": -580 },
    "gx": "floor((x_km + 520) / 2)",
    "gz": "floor((z_km + 580) / 2)",
    "cell_count_if_allocated": 286000,
    "materialized": false
  },
  "substages": [
    {
      "id": "climate",
      "writes": ["temperature", "rainfall", "humidity"],
      "annotation": "channel_carry",
      "rule": "One band per region. No second lapse on a W01 row. No second rain shadow. Mist does not leave its water body. Carry labels do not move a polyline or change depth_m."
    },
    {
      "id": "biome",
      "writes": ["biome", "soil"],
      "on_biome": ["ecosystem_key", "universe", "spawn", "density_0_1", "veg_marker", "viability_affinity_report"],
      "rule": "Class comes from the region row and must agree with the world flora_budget. classifyBiome may fill viability_affinity_report only."
    },
    {
      "id": "resources",
      "writes": ["resource", "fertility"],
      "rule": "Locus id must already sit on that region in W00. quantity null. Fertility is not written by civ, pop, or economy. A score is not a city."
    }
  ],
  "carry_classes": [
    { "id": "arid_trace", "mm_mid_max_exclusive": 250 },
    { "id": "seasonal_low", "mm_mid_max_exclusive": 600 },
    { "id": "moderate", "mm_mid_max_exclusive": 1000 },
    { "id": "wet", "mm_mid_max_exclusive": 1600 },
    { "id": "saturated", "mm_mid_min_inclusive": 1600 }
  ],
  "channel_carry": [
    { "body_id": "hub_civic_drain", "class": "moderate", "seasonal_wet_fraction": null, "depth_m_unchanged": true, "realizes_unchanged": true },
