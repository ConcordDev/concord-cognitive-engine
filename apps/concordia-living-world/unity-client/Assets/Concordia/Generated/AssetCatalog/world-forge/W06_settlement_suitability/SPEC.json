    {
      "schema": "concordia-world-forge-biome-resource/1.0",
      "slice_id": "W04_biome_resource_spec",
      "path": "world-forge/W04_biome_resource_spec/SPEC.json",
      "reads": ["fertility_0_1", "fertility_class", "suitability_cap", "veto", "resources", "stamp_cells", "biome_class"]
    },
    {
      "schema": "concordia-world-forge-hydrology/1.0",
      "slice_id": "W03_hydrology_spec",
      "path": "world-forge/W03_hydrology_spec/SPEC.json",
      "reads": ["water.kind", "body_id", "crossings_for_mobility"]
    },
    {
      "schema": "concordia-world-forge-continental/1.0",
      "slice_id": "W02_continental_spec",
      "path": "world-forge/W02_continental_spec/SPEC.json",
      "reads": ["slope class", "built_relief", "sea_mask"]
    },
    {
      "schema": "concordia-world-forge-field/1.0",
      "slice_id": "W01_world_field_schema",
      "path": "world-forge/W01_world_field_schema/SPEC.json",
      "reads": ["slope class breaks"]
    },
    {
      "schema": "concordia-world-forge-canon-graph/1.0",
      "slice_id": "W00_world_forge_canon_graph",
      "path": "world-forge/W00_world_forge_canon_graph/SPEC.json",
      "reads": ["worlds[].regions[]", "trade_nodes", "population_bias", "water_dependency", "constraints", "trade_graph"]
    }
  ],
  "authority_docs": [
    "lookfeel/MAP_MASTER.json",
    "lookfeel/geography/GEOGRAPHY_INDEX.json",
    "WORLD_FORGE_GEO_CIV_AUDIT.md",
    "world-forge/GEO_CIV_AUDIT.md"
  ],
  "honesty": "Scores sit on named W00 region_ids only. The 2 km grid is not allocated. Suitability is not a W01 field channel. Plaque minutes are not cities. Port records do not add cities. W04 suitability_cap and veto are honored. quantity stays null. population_bias.relative is not a census. Flower Law is 42 horizontal metres. world_id Fantasy is the Sundering. Sere has no Link gate. The Crucible-Grid seam stays unfinished. Hub territories stay empty. No Vinewood.",
  "pipeline": [
    "elevation",
    "hydrology",
    "climate",
    "biome",
    "resources",
    "mobility",
    "suitability",
    "civ",
    "pop",
    "economy",
    "growth",
    "infra",
    "physicalization"
  ],
  "writes_channels": [],
  "writes": "settlement_suitability_table",
  "graph_not_a_field_channel": true,
  "does_not_write": [
    "elevation",
    "slope",
    "geology",
    "drainage",
    "water",
    "temperature",
    "rainfall",
    "humidity",
    "biome",
    "soil",
    "resource",
    "fertility"
  ],
