{
  "schema": "concordia-world-forge-continental/1.0",
  "slice_id": "W02_continental_spec",
  "phase": "G1",
  "batch": "WF1_continental",
  "title": "Continental generator: landforms, mountain chains, passes, coasts, islands on the World Field",
  "consumes": [
    {
      "schema": "concordia-world-forge-field/1.0",
      "slice_id": "W01_world_field_schema",
      "path": "world-forge/W01_world_field_schema/SPEC.json"
    },
    {
      "schema": "concordia-world-forge-canon-graph/1.0",
      "slice_id": "W00_world_forge_canon_graph",
      "path": "world-forge/W00_world_forge_canon_graph/SPEC.json"
    }
  ],
  "authority_docs": [
    "lookfeel/MAP_MASTER.json",
    "lookfeel/geography/",
    "WORLD_FORGE_GEO_CIV_AUDIT.md",
    "world-forge/GEO_CIV_AUDIT.md"
  ],
  "honesty": "Feature geometry is design-intent constrained by W00 affinities and W01 exemplar bands. The 2 km grid is a contract, not a file. Sere, tunya_unplaced, tunya_fallback kilometres, the Last Dome mile, and the Ruins envoy claim are not stamped. Crucible crest metres are design-intent and are not in W01. Play-patch constants are copied from server/lib/world-terrain.js and are not retuned. islands is empty on purpose.",
  "pipeline": [
    "elevation",
    "hydrology",
    "climate",
    "biome",
    "resources",
    "mobility",
    "suitability",
    "civ",
    "pop",
    "economy",
    "growth",
    "infra",
    "physicalization"
  ],
  "writes_channels": ["elevation", "slope", "geology"],
  "leaves_for_later_stages": [
    "drainage",
    "water",
    "temperature",
    "rainfall",
    "humidity",
    "biome",
    "soil",
    "resource",
    "fertility"
  ],
  "continent": {
    "id": "concordia_megaworld",
    "frame": "megaworld_km",
    "origin": "Hub",
    "axes": "+x east toward Cyber, +z north toward the Sundering",
    "ring_km": 400.0,
    "seas": ["inner_veil", "exodus_ocean"],
    "sea_level_m": 0,
    "discs_are": "worlds on one field, not separate continents",
    "world_id_fantasy_display": "The Sundering",
    "world_id_unchanged": "Fantasy"
  },
  "frames": {
    "continental_veil_datum": {
      "unit": "metres above the Inner Veil / Exodus water plane",
      "horizontal": "megaworld_km",
      "cell_km": 2.0,
      "cell_authority": "design_intent",
      "sea_rule": "elevation_m <= 0 is the sea mask G2 inherits"
    },
    "hub_court_walk": {
      "unit": "metres above the Hub walk surface",
      "flower_law_radius_m": 42,
      "flower_law_axis": "horizontal",
      "court_absolute_veil": "inherit inner edge of hub_approaches band 15–40 m; do not store 0 and do not invent a surveyed offset"
    },
    "play_patch_metres": {
      "source": "server/lib/world-terrain.js",
      "symbols_unchanged": [
        "renderedElevationAt",
        "generatePoughkeepsieHeightmap",
        "terrainSpec",
        "sampleRenderedHeight",
        "hashSeed",
        "createSimplexNoise2D",
        "octaveNoise2D"
      ],
      "terrain_size_m": 2000,
      "max_elevation_m": 80,
      "seed": 12648430,
      "seed_hex": "0xc0ffee",
      "seed_is_per_world": false,
      "authority_label_for_later_binder": "play_patch_legacy",
      "must_not": "Add continental_veil_datum metres to renderedElevationAt. Retune the seed. Encode 42 as elevation."
    }
  },
  "grid": {
    "materialize": false,
    "cell_km": 2.0,
    "bbox_km": { "min_x": -520, "max_x": 520, "min_z": -580, "max_z": 520 },
    "origin": "southwest corner, cell (0,0)",
    "index": "gx = floor((x_km - min_x) / cell_km); gz likewise",
    "nx": 520,
    "nz": 550,
    "cell_count_if_allocated": 286000,
    "note": "Count is the design-intent allocation size. This catalog does not store the cells."
  },
  "seed_policy": {
    "macro": "feature stamp from chains, passes, coasts, marches, and sector bands. No simplex orogeny.",
    "micro": {
      "symbol": "hashSeed",
      "path": "server/lib/world-terrain.js",
      "algorithm": "fnv1a-32",
      "input": "worldId + ':' + gx + ':' + gz",
      "amplitude_m": "min(2, 0.02 * (band.max - band.min))",
      "clamp": "result stays inside the stamped band",
      "can_change_class": false,
      "applies_to_renderedElevationAt": false
    }
  },
  "algorithm": [
    "sea_mask_named_gaps_and_exodus_basin",
    "sector_stamp_inside_disc",
    "chain_ridge_stamp",
    "pass_carve",
    "land_march_interpolation",
    "coast_polyline",
    "island_flood_fill_clamp",
    "slope_from_neighbours",
    "geology_lookup",
    "built_relief_excluded_from_ground",
    "affinity_check"
  ],
  "slope_classes": [
    { "id": "near_level", "rise_over_run_max_exclusive": 0.04 },
    { "id": "gentle", "rise_over_run_max_exclusive": 0.12 },
    { "id": "moderate", "rise_over_run_max_exclusive": 0.25 },
    { "id": "steep", "rise_over_run_max_exclusive": 0.5 },
    { "id": "cliff", "rise_over_run_min_inclusive": 0.5 }
  ],
  "slope_sample": {
    "derived_from": "elevation",
    "neighbour": "4-neighbour",
    "run_m": 2000,
    "formula": "max abs(delta elevation_m) / 2000"
  },
  "built_relief_not_elevation": [
    "stack_vertical",
    "skybridge",
    "skyline",
    "roof_pad",
    "overpass_as_tall_ordinary",
    "low_wall",
    "fossil_span_over_dry_channel"
  ],
  "play_patch_mismatch": {
    "source_symbol": "renderedElevationAt",
    "shapes_in_the_walk_formula": [
      "river_zone_nx_below_0_1",
      "bluff_nx_0_1_to_0_2",
      "central_plateau_nx_0_2_to_0_6",
      "eastern_hills_nx_above_0_6",
      "fall_kill_creek_depression"
    ],
    "those_shapes_are": "Properties of the fixed Poughkeepsie profile. Not Hub terrain_affinity. Not a Tunya or Sundering class.",
    "geographic_reader": "continentalSpec"
  },
