(module
  (import "wasi_snapshot_preview1" "environ_sizes_get"
    (func $environ_sizes_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get"
    (func $environ_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2)
  (data (i32.const 1000) "SECRET_PROBE=")
  (data (i32.const 1020) "CONCORD_")
  (data (i32.const 1100) "ENV_LEAK\n")
  (data (i32.const 1120) "ENV_CLEAN\n")
  (func $puts (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $prefix_eq (param $s i32) (param $p i32) (param $n i32) (result i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $done (result i32)
      (loop $L
        (if (i32.ge_u (local.get $i) (local.get $n))
          (then (br $done (i32.const 1))))
        (if (i32.ne
              (i32.load8_u (i32.add (local.get $s) (local.get $i)))
              (i32.load8_u (i32.add (local.get $p) (local.get $i))))
          (then (br $done (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $L)
      )
      (i32.const 0)
    )
  )
  (func $main (export "_start")
    (local $count i32) (local $i i32) (local $ptr i32)
    (drop (call $environ_sizes_get (i32.const 16) (i32.const 20)))
    (local.set $count (i32.load (i32.const 16)))
    (if (i32.eqz (local.get $count))
      (then (call $puts (i32.const 1120) (i32.const 10)) (return)))
    (drop (call $environ_get (i32.const 256) (i32.const 4096)))
    (local.set $i (i32.const 0))
    (block $end
      (loop $scan
        (local.set $ptr
          (i32.load (i32.add (i32.const 256) (i32.mul (local.get $i) (i32.const 4)))))
        (if (call $prefix_eq (local.get $ptr) (i32.const 1000) (i32.const 13))
          (then (call $puts (i32.const 1100) (i32.const 9)) (return)))
        (if (call $prefix_eq (local.get $ptr) (i32.const 1020) (i32.const 8))
          (then (call $puts (i32.const 1100) (i32.const 9)) (return)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $scan (i32.lt_u (local.get $i) (local.get $count)))
      )
    )
    (call $puts (i32.const 1120) (i32.const 10))
  )
)
