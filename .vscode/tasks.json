{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Grok CLI",
      "type": "shell",
      "command": "/Users/dutch/.local/bin/grok",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/Users/dutch/.local/bin:/Users/dutch/.grok/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true,
        "echo": true,
        "clear": false
      }
    }
  ]
}
