
# Environment / secrets — never commit. .env.runpod and .env.example
# stay tracked as templates; .env (the active local-config file) and
# any deployment-specific overrides do not.
.env
.env.local
.env.production
.env.development
.env.test
server/.env
server/.env.local
concord-frontend/.env
concord-frontend/.env.local

# Dependencies
node_modules/

# Server generated files
server/node_modules/
server/concord_state.json
concord_state.json
data/

# Un-ignore seed pack directory (canonical DTU source, committed to repo)
# gitignore requires un-ignoring each parent directory in the chain,
# then re-ignoring siblings we don't want tracked.
!server/data/
server/data/*
!server/data/seed/
!server/data/seed/**

# Authored Godot hub NPC data (schedules / dialogue / affinity). The root
# `data/` rule above would otherwise swallow world-lens-godot/data/npcs/**.
!world-lens-godot/data/
world-lens-godot/data/*
!world-lens-godot/data/npcs/
!world-lens-godot/data/npcs/**

# Test coverage output
coverage/

# Next.js build output (when built from root)
.next/
server/tests/.verification_scorecard.db

# Test parity state dumps (auto-generated, huge, per-run).
# Trailing `*` is load-bearing: the server persists this file atomically
# (write `<name>.json.tmp`, then rename), so a run interrupted mid-write
# leaves a `.json.tmp` behind. The old `*.json` patterns didn't match that
# suffix, so the stray file showed up as untracked repo noise.
.parity-test-state-*.json*
server/.parity-test-state-*.json*

# Test data directories (auto-generated during E2E/integration runs)
server/.parity-test-data-*/

# Frontend build output (.next inside concord-frontend)
concord-frontend/.next/
concord-frontend/node_modules/

# Claude Code internal state (agent worktrees, plan files, etc.)
.claude/worktrees/

# Runtime-generated detector telemetry (the backend appends every 5 min while running)
audit/detectors/macro-telemetry.jsonl
audit/detectors/runtime-history.jsonl
server/audit/detectors/macro-telemetry.jsonl
server/audit/detectors/runtime-history.jsonl

# Godot engine runtime (see docs/GODOT_RUNTIME.md). The engine binary is ~127MB
# and is NEVER committed — `node scripts/fetch-godot.mjs` reproduces it with
# checksum verification into this directory.
.godot-runtime/

# Godot per-project import cache. Regenerated by `godot --headless --import`;
# upstream Godot docs say to gitignore it. (The sibling `*.gd.uid` files that
# Godot 4.4 also generates are NOT ignored here — upstream recommends
# committing those; that call is left to a human.)
world-lens-godot/.godot/

# Per-resource `.import` sidecar files (e.g. tests/goldens/*.png.import).
# Godot regenerates these on every `--import` pass from the resource + editor
# defaults; zero were ever committed in this repo (verified: `git ls-files
# world-lens-godot | grep -c '\.import$'` = 0), so this codifies the existing
# convention rather than changing it.
world-lens-godot/**/*.import

# Godot export templates + export output. The templates archive is a 1.12 GiB
# download and the extracted set is ~2 GB; `node scripts/fetch-godot.mjs
# --export-templates` puts them in the EDITOR DATA DIR (outside the repo) and
# deletes the archive afterwards, so these patterns are belt-and-braces against
# someone passing --templates-dest into the tree or curl-ing the .tpz here.
# NOTE: world-lens-godot/export_presets.cfg is deliberately NOT ignored — it is
# source, and export cannot run without it.
*.tpz
export_templates/
world-lens-godot/build/
world-lens-godot/*.pck
world-lens-godot/*.x86_64

# Web export output (scripts/export-godot-web.mjs / `npm run export:web`).
# Regenerated on demand from world-lens-godot/ + export_presets.cfg's "Web"
# preset; a build artefact (~42MB .wasm alone), never committed. Lands in
# concord-frontend/public/ so it's servable with zero new infra — see that
# script's header for why nothing else needed to change.
concord-frontend/public/godot-client/

# AssemblyScript build output (server/lib/wasm/**/*.ts sources are committed;
# the compiled .wasm/.wat/.js/.d.ts are build artefacts, regenerated via
# `npx asc <source>.ts --outFile server/lib/wasm/build/<name>.wasm --optimize`).
server/lib/wasm/build/
# Raw Godot export staging dir (scripts/export-godot-web.mjs) — holds the
# exported index.html the app/godot-client/index.html/route.ts handler reads
# and nonce-injects at request time. Never served directly; see either
# file's header for why index.html is kept out of public/.
concord-frontend/.godot-web-staging/

# Vendored Pyodide scientific packages (scripts/fetch-pyodide-packages.mjs /
# server npm script `fetch-pyodide-packages`). Checksum-verified wheels for
# numpy/pandas/matplotlib/scipy/sympy + their transitive deps (~16 files,
# see server/lib/pyodide-packages.js) — a regenerated, checksum-pinned
# artifact, never committed, same convention as the Godot web export above.
server/data/pyodide-packages/

# Visual-QA harness output (scripts/visual-qa.mjs). Full-resolution 1152x648
# captures + the engine log for one run; regenerated on every run and never
# committed. The DOWNSAMPLED golden baselines it compares against
# (world-lens-godot/tests/goldens/, ~2-4 KB each) ARE committed — that is the
# whole point of a baseline — and are deliberately NOT ignored here.
world-lens-godot/.visual-qa/

# Next.js auto-generated
concord-frontend/next-env.d.ts

# Local DB files / snapshots — generated runtime artifacts, may contain user
# data, never committed. (server/data/seed/** above is the real seed pack.)
*.sqlite
*.sqlite3
concord.db
server/concord.db

# Ad-hoc env backups made during deploy/debug sessions — these routinely pick
# up real secret values (tunnel tokens, API keys) that .env.runpod's tracked
# template intentionally keeps blank. Never commit a backup of a real config.
.env.bak*
.env.*.bak*
.env.runpod.bak*

# macOS AppleDouble resource-fork junk (created by zip/unzip and Finder
# copies over network/mfs volumes) — pure noise, never intentional content.
._*

# Runtime logs directory (pm2/deploy script output)
logs/

# Real secrets extracted out of a tracked .env.* template during a deploy
# session (see .env.runpod's history for why this pattern exists — a real
# Cloudflare tunnel token once got hand-appended to the tracked file).
*.secrets.local

# Defense-in-depth: none of these exist in the tree today, but any key/cert/
# credential file dropped in during deploy or debugging (SSH private keys,
# TLS certs, cloud service-account JSON, keystores) must never be committable
# by accident. k8s/secrets.yaml is the deliberate exception — its values are
# base64 "CHANGE_ME_..." placeholders, not real secrets, so it stays tracked.
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
*.p12
*.pfx
*.keystore
*.jks
credentials.json
*-serviceaccount*.json
*service-account*.json
gcloud-*.json
.aws/credentials
.aider*

# RunPod API credentials (used ad-hoc via curl during infra incidents —
# never persisted to a tracked file, but ignored defensively in case a
# future setup step writes a config/token file here).
.runpod/
runpod-api-key*
.runpodctl*
