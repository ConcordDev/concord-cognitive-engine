
# Environment / secrets — never commit. .env.runpod and .env.example
# stay tracked as templates; .env (the active local-config file) and
# any deployment-specific overrides do not.
.env
.env.local
.env.production
.env.development
.env.test
server/.env
server/.env.local
concord-frontend/.env
concord-frontend/.env.local

# Dependencies
node_modules/

# Server generated files
server/node_modules/
server/concord_state.json
concord_state.json
data/

# Un-ignore seed pack directory (canonical DTU source, committed to repo)
# gitignore requires un-ignoring each parent directory in the chain,
# then re-ignoring siblings we don't want tracked.
!server/data/
server/data/*
!server/data/seed/
!server/data/seed/**

# Test coverage output
coverage/

# Next.js build output (when built from root)
.next/
server/tests/.verification_scorecard.db

# Test parity state dumps (auto-generated, huge, per-run).
# Trailing `*` is load-bearing: the server persists this file atomically
# (write `<name>.json.tmp`, then rename), so a run interrupted mid-write
# leaves a `.json.tmp` behind. The old `*.json` patterns didn't match that
# suffix, so the stray file showed up as untracked repo noise.
.parity-test-state-*.json*
server/.parity-test-state-*.json*

# Test data directories (auto-generated during E2E/integration runs)
server/.parity-test-data-*/

# Frontend build output (.next inside concord-frontend)
concord-frontend/.next/
concord-frontend/node_modules/

# Claude Code internal state (agent worktrees, plan files, etc.)
.claude/worktrees/

# Runtime-generated detector telemetry (the backend appends every 5 min while running)
audit/detectors/macro-telemetry.jsonl
audit/detectors/runtime-history.jsonl
server/audit/detectors/macro-telemetry.jsonl
server/audit/detectors/runtime-history.jsonl

# Godot engine runtime (see docs/GODOT_RUNTIME.md). The engine binary is ~127MB
# and is NEVER committed — `node scripts/fetch-godot.mjs` reproduces it with
# checksum verification into this directory.
.godot-runtime/

# Godot per-project import cache. Regenerated by `godot --headless --import`;
# upstream Godot docs say to gitignore it. (The sibling `*.gd.uid` files that
# Godot 4.4 also generates are NOT ignored here — upstream recommends
# committing those; that call is left to a human.)
world-lens-godot/.godot/

# Godot export templates + export output. The templates archive is a 1.12 GiB
# download and the extracted set is ~2 GB; `node scripts/fetch-godot.mjs
# --export-templates` puts them in the EDITOR DATA DIR (outside the repo) and
# deletes the archive afterwards, so these patterns are belt-and-braces against
# someone passing --templates-dest into the tree or curl-ing the .tpz here.
# NOTE: world-lens-godot/export_presets.cfg is deliberately NOT ignored — it is
# source, and export cannot run without it.
*.tpz
export_templates/
world-lens-godot/build/
world-lens-godot/*.pck
world-lens-godot/*.x86_64
