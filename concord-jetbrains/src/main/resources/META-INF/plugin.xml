<idea-plugin>
  <id>ai.concord.jetbrains</id>
  <name>Concord DX</name>
  <vendor email="hello@concord-os.org" url="https://concord-os.org">Concord OS</vendor>

  <description><![CDATA[
    Concord DX in JetBrains IDEs (IntelliJ IDEA, WebStorm, PyCharm, GoLand, etc.).<br/>
    Detector findings stream as inline highlights; repair-cortex proposals
    appear as Accept / Ignore / Reject prompts. Backed by the same
    <a href="https://github.com/ryttps94jq-gif/concord-cognitive-engine/tree/main/concord-lsp">concord-lsp</a>
    that powers the VS Code extension.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.redhat.devtools.lsp4ij</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Persistent application-level settings -->
    <applicationService
      serviceImplementation="ai.concord.jetbrains.settings.ConcordSettingsState"/>

    <!-- Settings → Tools → Concord -->
    <applicationConfigurable
      parentId="tools"
      instance="ai.concord.jetbrains.settings.ConcordSettingsConfigurable"
      id="ai.concord.jetbrains.settings.ConcordSettingsConfigurable"
      displayName="Concord"/>

    <!-- View → Tool Windows → Concord -->
    <toolWindow
      id="Concord"
      anchor="right"
      icon="AllIcons.Actions.Find"
      factoryClass="ai.concord.jetbrains.toolwindow.ConcordToolWindowFactory"/>

  </extensions>

  <!-- LSP server registration via LSP4IJ: the bundled concord-lsp is
       launched via stdio by ConcordLanguageServer (lsp/ package), which
       reads apiUrl from settings and the token from PasswordSafe at
       server-start time and passes both as initializationOptions. -->
  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="concordLanguageServer"
            name="Concord DX"
            factoryClass="ai.concord.jetbrains.lsp.ConcordLanguageServerFactory">
      <description><![CDATA[
        Concord DX language server (concord-lsp). Detector findings stream
        as inline highlights; repair proposals appear as Accept / Ignore /
        Reject prompts. Configure the API URL and sign-in under
        Settings → Tools → Concord.
      ]]></description>
    </server>
    <fileNamePatternMapping patterns="*.js;*.mjs;*.cjs"
                            serverId="concordLanguageServer"
                            languageId="javascript"/>
    <fileNamePatternMapping patterns="*.jsx"
                            serverId="concordLanguageServer"
                            languageId="javascriptreact"/>
    <fileNamePatternMapping patterns="*.ts"
                            serverId="concordLanguageServer"
                            languageId="typescript"/>
    <fileNamePatternMapping patterns="*.tsx"
                            serverId="concordLanguageServer"
                            languageId="typescriptreact"/>
    <fileNamePatternMapping patterns="*.py"
                            serverId="concordLanguageServer"
                            languageId="python"/>
    <fileNamePatternMapping patterns="*.json"
                            serverId="concordLanguageServer"
                            languageId="json"/>
  </extensions>

  <actions>
    <action
      id="ai.concord.jetbrains.SignIn"
      class="ai.concord.jetbrains.actions.ConcordSignInAction"
      text="Concord: Sign in"
      description="Sign in to Concord via browser-based OAuth (RFC 8252 loopback redirect).">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>

</idea-plugin>
