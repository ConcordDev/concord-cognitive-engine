<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Second HTTP worker (NODE_APP_INSTANCE=1) — NO heartbeat.
  Heap 3072 (or 2048 if RAM tight). Pair with primary; sticky via port/nginx.
  Never commit a filled copy (secrets stay in local plist / .env).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.concord.backend-i1</string>
  <key>WorkingDirectory</key>
  <string>PLACEHOLDER_REPO/server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--max-old-space-size=3072</string>
    <string>--expose-gc</string>
    <string>PLACEHOLDER_REPO/server/server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>5051</string>
    <key>NODE_APP_INSTANCE</key>
    <string>1</string>
    <key>CONCORD_DTU_SIDECAR</key>
    <string>1</string>
    <key>CONCORD_WALLET_SIDECAR</key>
    <string>1</string>
    <key>CONCORD_SESSION_SIDECAR</key>
    <string>1</string>
    <key>CONCORD_STICKY_REDIS</key>
    <string>1</string>
    <key>DATA_DIR</key>
    <string>PLACEHOLDER_REPO/server/data</string>
    <key>ENV_PATH</key>
    <string>PLACEHOLDER_REPO/.env</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>PLACEHOLDER_LOG_DIR/backend-i1.log</string>
  <key>StandardErrorPath</key>
  <string>PLACEHOLDER_LOG_DIR/backend-i1.err</string>
</dict>
</plist>
