# Cloudflared config-file template (use only in CONFIG-FILE MODE).
#
# Copy to cloudflared.yml, fill in <TUNNEL_UUID> and <YOUR_DOMAIN>,
# then place credentials.json (downloaded from Cloudflare's Zero Trust
# dashboard) next to this file.
#
# In TOKEN MODE the entire ingress block lives in the Cloudflare
# dashboard instead, and you don't need this file.
#
# ── PICK YOUR ORIGIN NAMES BY TOPOLOGY ──────────────────────────────
# The service targets below differ between the two deployment paths:
#
#   BARE METAL (pm2 / startup.sh — the A40 path):
#     frontend  → http://127.0.0.1:3000
#     backend   → http://127.0.0.1:5050
#
#   DOCKER COMPOSE (cloudflared runs as a compose sidecar):
#     frontend  → http://frontend:3000
#     backend   → http://backend:5050
#
# This template defaults to BARE METAL. For docker, swap the hosts.
#
# ── ROUTING MODEL ───────────────────────────────────────────────────
# The FRONTEND (Next.js, :3000) is the root origin — it serves the app
# and proxies /api/* to the backend via its rewrites. WebSocket traffic
# (/socket.io, /godot-ws, /unity-ws) MUST go straight to the backend (:5050):
# Next's rewrites proxy HTTP but do NOT forward WebSocket upgrades
# (observed live: same-origin sockets to :3000 die with "WebSocket is
# closed before the connection is established").

tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/credentials.json

ingress:
  # socket.io realtime — MUST hit the backend directly (WS upgrade).
  # Path rules must precede the catch-all hostname rule.
  - hostname: concord.<YOUR_DOMAIN>
    path: /socket.io/.*
    service: http://127.0.0.1:5050
    originRequest:
      connectTimeout: 30s
      keepAliveTimeout: 90s

  # Godot client gateway — raw WebSocket, same reasoning as socket.io.
  - hostname: concord.<YOUR_DOMAIN>
    path: /godot-ws.*
    service: http://127.0.0.1:5050

  # Unity WebGL gateway — same kernel path as Godot (/unity-ws).
  - hostname: concord.<YOUR_DOMAIN>
    path: /unity-ws.*
    service: http://127.0.0.1:5050

  # API + health straight to the backend. The frontend's rewrites CAN
  # proxy these, but that adds a second proxy hop — the backend then
  # sees every request from 127.0.0.1 and per-IP rate limiting collapses
  # into one bucket (TRUST_PROXY=1 counts exactly one hop). Routing
  # /api directly keeps every backend-bound path at one hop.
  - hostname: concord.<YOUR_DOMAIN>
    path: /api/.*
    service: http://127.0.0.1:5050
  - hostname: concord.<YOUR_DOMAIN>
    path: /health
    service: http://127.0.0.1:5050
  - hostname: concord.<YOUR_DOMAIN>
    path: /ready
    service: http://127.0.0.1:5050

  # Main app — the Next.js frontend. Its runtime rewrites proxy
  # /api/*, /health, /ready to the backend, so everything else
  # (pages, /_next/static assets, API calls) flows through :3000.
  - hostname: concord.<YOUR_DOMAIN>
    service: http://127.0.0.1:3000
    originRequest:
      noTLSVerify: false
      connectTimeout: 30s
      keepAliveTimeout: 90s

  # Optional — expose Ollama brains through the tunnel only if you
  # need remote brain access (most operators do NOT — keep brains
  # private). Uncomment + customize if needed.
  # - hostname: brain.<YOUR_DOMAIN>
  #   service: http://127.0.0.1:11434

  # Optional — Grafana dashboard at metrics.<YOUR_DOMAIN> (docker only).
  # - hostname: metrics.<YOUR_DOMAIN>
  #   service: http://grafana:3000

  # CATCH-ALL — required. Anything that doesn't match the rules above
  # gets a 404 from cloudflared without hitting your origin.
  - service: http_status:404
